{
  "expo": {
    "name": "Rota",
    "slug": "rota",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "scheme": "rota",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rota.shifts"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.rota.shifts"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "9a8b7c6d-5e4f-3a2b-1c0d-e9f8a7b6c5d4"
      }
    }
  }
}
